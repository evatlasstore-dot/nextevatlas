# Public canonical URL used in links generated outside the website.
NEXT_PUBLIC_SITE_URL=https://www.evatlas.store
# Optional Google Search Console HTML verification token (use the token only, not the full meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Quote-form e-mail delivery (server-side only)
# Copy this file to .env.local and replace the values locally. Never commit .env.local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=evatlas.store@gmail.com
# Paste the dedicated 16-character Gmail app password here. Spaces are accepted.
SMTP_PASSWORD=replace-with-your-gmail-app-password

# Destination for new quote requests and the authenticated sender address.
QUOTE_NOTIFICATION_EMAIL=evatlas.store@gmail.com
MAIL_FROM="EVAtlas <evatlas.store@gmail.com>"
